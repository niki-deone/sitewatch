# .env.example
# Copy to .env.local for local development. On Vercel, add the same keys in Project Settings > Environment Variables.

# Postgres connection string. Neon: use the "pooled" connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sitewatch

# Auth.js secret. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=

# GitHub OAuth app (github.com/settings/developers > OAuth Apps)
# Callback URL: https://YOUR-DOMAIN/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Shared secret for the scheduler endpoint /api/cron/check. Any long random string.
CRON_SECRET=

# Public base URL, used in alert links and the status page URL shown in settings.
APP_URL=http://localhost:3000

# Set to "off" to hide the read-only demo login.
DEMO_LOGIN=on

# Development only: allow monitoring localhost and private IPs. Ignored in production.
ALLOW_PRIVATE_TARGETS=0
